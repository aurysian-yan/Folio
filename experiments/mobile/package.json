{
  "name": "folio-mobile-poc",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "APP_VARIANT=development expo prebuild --platform android --no-install --no-clean && APP_VARIANT=development expo run:android",
    "android:release": "APP_VARIANT=production expo prebuild --platform android --no-install --no-clean && APP_VARIANT=production expo run:android --variant release",
    "ios": "APP_VARIANT=development expo prebuild --platform ios --no-install --no-clean && APP_VARIANT=development expo run:ios --no-install",
    "ios:release": "APP_VARIANT=production expo prebuild --platform ios --no-install --no-clean && APP_VARIANT=production expo run:ios --no-install --configuration Release",
    "ide:android": "node scripts/open-ide.mjs android",
    "ide:ios": "node scripts/open-ide.mjs ios",
    "prebuild": "expo prebuild --no-install --no-clean",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --no-install --no-clean",
    "prebuild:release": "APP_VARIANT=production expo prebuild --no-install --no-clean",
    "pods": "node scripts/install-pods.mjs",
    "bindings": "node scripts/build-rust.mjs bindings",
    "rust:android": "node scripts/build-rust.mjs android",
    "rust:ios": "node scripts/build-rust.mjs ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:swift": "node scripts/smoke-swift.mjs",
    "samples": "node scripts/prepare-samples.mjs"
  },
  "dependencies": {
    "@expo/ui": "57.0.21",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-dev-client": "57.0.19",
    "expo-document-picker": "57.0.3",
    "expo-image": "57.0.5",
    "expo-modules-core": "57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "phosphor-react-native": "3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.2",
    "typescript": "6.0.3"
  }
}
